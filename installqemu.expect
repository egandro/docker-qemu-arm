#!/data/data/com.termux/files/usr/bin/expect -f

# source by https://www.sitepoint.com/hardened-mobile-dev-a-termux-docker-guide-for-grapheneos/

# ==========================================
# CONFIGURAÇÕES INICIAIS
# ==========================================
set timeout -1

# Fallbacks seguros para variáveis de ambiente
set DISK_SIZE [expr {[info exists env(DISK_SIZE)] ? $env(DISK_SIZE) : "10G"}]
set ROOT_PASSWORD [expr {[info exists env(ROOT_PASSWORD)] ? $env(ROOT_PASSWORD) : "alpine"}]

# Validação e leitura do answerfile
if {![file exists "./answerfile"]} {
    puts "ERRO: Arquivo ./answerfile nao encontrado no diretorio atual!"
    exit 1
}
set fp [open "./answerfile" r]
set answerfile [read $fp]
close $fp

# Definição de caminhos
set INSTALLATION_DIR "$env(HOME)/alpine-arm"
set BIOS "$INSTALLATION_DIR/BIOS/QEMU_EFI.fd"
set DRIVE "$INSTALLATION_DIR/DRIVE/alpine-docker.qcow2"
set CDROM "$INSTALLATION_DIR/CDROM/alpine-arm.iso"

# ==========================================
# PREPARAÇÃO DO HOST
# ==========================================
spawn mkdir -p $INSTALLATION_DIR/BIOS $INSTALLATION_DIR/DRIVE $INSTALLATION_DIR/CDROM
expect eof

catch {spawn cp ssh2qemu.sh $INSTALLATION_DIR}
expect eof

spawn rm -f $INSTALLATION_DIR/qemukey $INSTALLATION_DIR/qemukey.pub
expect eof

spawn ssh-keygen -b 2048 -t rsa -N "" -f $INSTALLATION_DIR/qemukey
expect eof

set fp [open "$INSTALLATION_DIR/qemukey.pub" r]
set qemukey [read $fp]
close $fp

spawn rm -f $DRIVE
expect eof

spawn qemu-img create -f qcow2 $DRIVE $DISK_SIZE
expect eof
sleep 2

# ==========================================
# FASE 1: INSTALAÇÃO (QEMU BOOT 1)
# ==========================================
# Atualizado com as flags do artigo (2GB RAM, nic user, boot d, format=qcow2)
spawn qemu-system-aarch64 -machine virt -m 2048 -smp cpus=2 -cpu cortex-a57 \
    -bios $BIOS \
    -nic user,id=n1,hostfwd=tcp::8822-:22,hostfwd=tcp::7300-:3000 \
    -drive file=$DRIVE,format=qcow2,if=virtio \
    -cdrom $CDROM \
    -boot d \
    -nographic

set qemuID $spawn_id

expect "login:"
send "root\r"

expect ":~#"
send "echo 'nameserver 8.8.8.8' > /etc/resolv.conf\r"

expect ":~#"
send "sed -i 's/^#RESOLV_CONF=\"no\"/RESOLV_CONF=\"no\"/' /etc/udhcpc/udhcpc.conf\r"

expect ":~#"
send "echo 'net.ipv6.conf.all.disable_ipv6 = 1' >> /etc/sysctl.conf\r"

expect ":~#"
send "sysctl -p\r"

expect ":~#"
send "setup-interfaces\r"
expect "\[eth0\]" { send "\r" }
expect "\[dhcp\]" { send "\r" }
expect "\[no\]"   { send "\r" }

expect ":~#"
send "ifup eth0\r"

# INJEÇÃO DO ANSWERFILE
expect ":~#"
send "cat << 'EOF' > /root/answerfile\r"
send "$answerfile"
if {[string index $answerfile end] ne "\n"} { send "\r" }
send "EOF\r"

# =====================================================================
# A BALA DE PRATA: Detecção Dinâmica do Disco
# Procura em /proc/partitions o disco virtio (vdX) maior que 1GB
# e substitui o /dev/vda do seu answerfile pelo disco real.
# =====================================================================
expect ":~#"
send {REAL_DISK=$(grep -E 'vd[a-z]$' /proc/partitions | awk '$3 > 1000000 {print "/dev/" $4}')}
send "\r"

expect ":~#"
send {sed -i -E "s|/dev/vd[a-z]|$REAL_DISK|g" /root/answerfile}
send "\r"
# =====================================================================

expect ":~#"
send "setup-alpine -f /root/answerfile\r"

expect "password:"
send "$ROOT_PASSWORD\r"
expect "password:"
send "$ROOT_PASSWORD\r"

expect "Setup a user?"
send "\r"

expect "Erase the above disk"
send "y\r"

expect "Please reboot"
send "poweroff\r"

expect eof

# ==========================================
# FASE 2: CONFIGURAÇÃO (QEMU BOOT 2)
# ==========================================
spawn qemu-system-aarch64 -machine virt -m 2048 -smp cpus=2 -cpu cortex-a57 \
    -bios $BIOS \
    -nic user,id=n1,hostfwd=tcp::8822-:22,hostfwd=tcp::7300-:3000 \
    -drive file=$DRIVE,format=qcow2,if=virtio \
    -nographic

set qemuID $spawn_id

expect "login:"
send "root\r"

expect "Password:"
send "$ROOT_PASSWORD\r"

expect ":~#"
send "sed -i -E 's/^#PermitRootLogin prohibit-password/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config\r"

expect ":~#"
send "service sshd start\r"

expect ":~#"
send "echo 'nameserver 8.8.8.8' > /etc/resolv.conf\r"

expect ":~#"
send "sed -i 's/^#RESOLV_CONF=\"no\"/RESOLV_CONF=\"no\"/' /etc/udhcpc/udhcpc.conf\r"

expect ":~#"
send "sed -i 's|^#http://|http://|' /etc/apk/repositories\r"

# Adicionado docker-cli-compose conforme o artigo
expect ":~#"
send "apk update && apk add docker docker-cli-compose ip6tables zram-init\r"

expect ":~#"
send "service docker start\r"

expect ":~#"
send "rc-update add docker\r"

expect ":~#"
send "sed -i -E 's/num_devices=2/num_devices=1/' /etc/conf.d/zram-init\r"

expect ":~#"
send "sed -i -E 's/^algo0=zstd/algo0=lzo/' /etc/conf.d/zram-init\r"

expect ":~#"
send "service zram-init start\r"

expect ":~#"
send "rc-update add zram-init\r"

expect ":~#"
send "mkdir -p /root/.ssh\r"

expect ":~#"
send "chmod 700 /root/.ssh\r"

expect ":~#"
send "cat << 'EOF' >> /root/.ssh/authorized_keys\r"
send "$qemukey"
if {[string index $qemukey end] ne "\n"} { send "\r" }
send "EOF\r"

expect ":~#"
send "poweroff\r"

expect eof
puts "\n✅ Instalacao e configuracao concluidas com sucesso!"